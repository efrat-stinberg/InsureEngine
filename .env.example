# Copy this file to .env and fill in real values.
# Different modules in this project read different Supabase key variables
# (see README.md for which module uses which) — set all of them.

# Base Supabase project URL (same value for all three key variants below)
SUPABASE_URL=

# Used by insure_engine/post_fetcher.py to read posts
SUPABASE_ANON_KEY=

# Used by insure_engine/comments.py to write/read comments (needs write access)
SUPABASE_SERVICE_ROLE_KEY=

# Used by insure_engine/supabase_rag.py for the semantic-search RPC call
SUPABASE_KEY=

# OpenAI API key, used for embeddings (text-embedding-3-small) and answer
# generation (gpt-4)
OPENAI_API_KEY=

# UUID of the bot's user account in Supabase; comments are published under
# this user id
BOT_USER_ID=
